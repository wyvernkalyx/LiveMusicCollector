{
  "name": "live-music-collector",
  "version": "0.1.0",
  "description": "A desktop application for managing live music collections",
  "main": "src/main/index.js",
  "scripts": {
    "start": "concurrently \"npm run start:main\" \"npm run start:renderer\"",
    "start:main": "electron .",
    "start:renderer": "vite",
    "build": "npm run build:renderer && npm run build:main",
    "build:main": "node build.js",
    "build:renderer": "vite build",
    "dev": "concurrently \"npm run dev:main\" \"npm run dev:renderer\"",
    "dev:main": "nodemon --exec electron . --watch src/main",
    "dev:renderer": "vite",
    "test": "jest",
    "lint": "eslint src --ext .js,.jsx,.ts,.tsx"
  },
  "keywords": [
    "music",
    "collection",
    "electron",
    "react"
  ],
  "author": "Your Name",
  "license": "MIT",
  "devDependencies": {
    "@emotion/babel-plugin": "^11.13.5",
    "@types/react": "^18.2.0",
    "@types/react-dom": "^18.2.0",
    "@vitejs/plugin-react": "^4.0.0",
    "concurrently": "^8.2.0",
    "electron": "^38.1.0",
    "electron-builder": "^24.6.4",
    "electron-rebuild": "^3.2.9",
    "eslint": "^8.45.0",
    "eslint-plugin-react": "^7.33.0",
    "eslint-plugin-react-hooks": "^4.6.0",
    "jest": "^29.6.0",
    "nodemon": "^3.0.0",
    "vite": "^7.1.5"
  },
  "dependencies": {
    "@emotion/react": "^11.11.0",
    "@emotion/styled": "^11.11.0",
    "axios": "^1.12.2",
    "chokidar": "^4.0.3",
    "date-fns": "^2.30.0",
    "electron-store": "^8.1.0",
    "fpcalc": "^1.3.0",
    "lucide-react": "^0.263.1",
    "music-metadata": "^8.1.0",
    "musicbrainz-api": "^0.25.1",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-query": "^3.39.0",
    "react-router-dom": "^6.14.0",
    "sqlite3": "^5.1.7",
    "zustand": "^4.4.0"
  },
  "build": {
    "appId": "com.yourcompany.livemusiccollector",
    "productName": "Live Music Collector",
    "directories": {
      "output": "dist"
    },
    "files": [
      "src/main/**/*",
      "node_modules/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "src/renderer/dist",
        "to": "renderer",
        "filter": [
          "**/*"
        ]
      }
    ],
    "win": {
      "target": "nsis",
      "icon": "public/icon.ico"
    }
  }
}
